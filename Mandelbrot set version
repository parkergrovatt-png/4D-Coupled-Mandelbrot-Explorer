# fractal_microscope.py
import numpy as np
import pygame
from numba import njit, prange
import matplotlib.cm as cm
import time

# ----------------------
# Parameters & settings
# ----------------------
WIDTH, HEIGHT = 1000, 800
MAX_ITER = 300
ESCAPE_RADIUS = 4.0
# initial view of k-plane (center + half-width)
center_kx, center_ky = -0.5, 0.0
scale = 3.0  # width of view in complex plane (real axis)
aspect = HEIGHT / WIDTH

# initial c0
c0_re = 0.0
c0_im = 0.0
c_im_velocity = 0.0  # velocity along Im(c0) (units per second)
c_im_step = 0.02     # keyboard incremental change to velocity
c_re_step = 0.02     # W/S move step for Re(c0)

# pan & zoom steps
pan_frac = 0.08
zoom_factor = 1.1

# performance
COMPUTE_EVERY_FRAMES = 1  # how many frames between full recompute
USE_SMOOTH = True

# colormap
cmap = cm.get_cmap("twilight_shifted")

# ----------------------
# Numba-accelerated compute
# ----------------------
@njit(parallel=True, fastmath=True)
def compute_fractal(width, height, center_kx, center_ky, scale,
                    c0_re, c0_im, max_iter, escape_radius, smooth):
    result = np.zeros((height, width), dtype=np.float64)
    half_w = scale / 2.0
    dx = scale / width
    dy = (scale * (height/width)) / height  # maintain aspect ratio
    y0 = center_ky - (dy * height / 2.0)
    x0 = center_kx - (dx * width / 2.0)

    for j in prange(height):
        ky = y0 + j * dy
        for i in range(width):
            kx = x0 + i * dx
            k_real = kx
            k_imag = ky

            z_re = 0.0
            z_im = 0.0
            c_re = c0_re
            c_im = c0_im

            escape_iter = max_iter
            for n in range(max_iter):
                # z = z^2 + c
                # compute z*z
                zr2 = z_re * z_re
                zi2 = z_im * z_im
                z_im = 2.0 * z_re * z_im + c_im
                z_re = zr2 - zi2 + c_re

                # c = c^2 + k
                cr2 = c_re * c_re
                ci2 = c_im * c_im
                c_im = 2.0 * c_re * c_im + k_imag
                c_re = cr2 - ci2 + k_real

                # check escape
                modz2 = z_re * z_re + z_im * z_im
                modc2 = c_re * c_re + c_im * c_im
                if modz2 > escape_radius*escape_radius or modc2 > escape_radius*escape_radius:
                    escape_iter = n
                    if smooth:
                        # smooth the escape for z if possible, fallback on n
                        if modz2 > 0:
                            # approximation using log log for smooth coloring
                            log_zn = 0.5 * np.log(modz2)
                            nu = np.log(log_zn / np.log(2.0)) / np.log(2.0)
                            escape_iter = n + 1 - nu
                    break

            result[j, i] = escape_iter / max_iter


    return result

# ----------------------
# Helper: map to RGB surface
# ----------------------
def array_to_surface(arr, colormap):
    # arr in 0..1 float
    rgba = colormap(arr, bytes=True)  # returns uint8 RGBA
    rgb = rgba[:, :, :3]
    surf = pygame.surfarray.make_surface(np.transpose(rgb, (1, 0, 2)))
    return surf

# ----------------------
# Main loop: pygame app
# ----------------------
def main():
    global center_kx, center_ky, scale, c0_re, c0_im, c_im_velocity

    pygame.init()
    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    pygame.display.set_caption("4D Fractal Microscope — k-plane explorer")
    clock = pygame.time.Clock()

    needs_compute = True
    frame_count = 0
    last_time = time.time()
    running = True
    paused = False

    # simple on-screen font
    font = pygame.font.SysFont("Consolas", 11)

    while running:
        dt = clock.tick(30) / 1000.0  # seconds
        frame_count += 1
        # handle events
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE:
                    paused = not paused
                if event.key == pygame.K_r:
                    c_im_velocity = -c_im_velocity
                if event.key == pygame.K_a:  # zoom out
                    # zoom out centered
                    scale *= zoom_factor
                    needs_compute = True
                if event.key == pygame.K_d:  # zoom in
                    scale /= zoom_factor
                    needs_compute = True

        # continuous key states
        keys = pygame.key.get_pressed()
        # pan k-plane with arrows (fraction of current scale)
        pan_x = 0.0
        pan_y = 0.0
        if keys[pygame.K_LEFT]:
            pan_x = -pan_frac * scale
        if keys[pygame.K_RIGHT]:
            pan_x = pan_frac * scale
        if keys[pygame.K_UP]:
            pan_y = -pan_frac * (scale * (HEIGHT/WIDTH))
        if keys[pygame.K_DOWN]:
            pan_y = pan_frac * (scale * (HEIGHT/WIDTH))
        if pan_x != 0.0 or pan_y != 0.0:
            center_kx += pan_x * dt * 10.0  # multiply by dt to make speed smooth
            center_ky += pan_y * dt * 10.0
            needs_compute = True

        # W/S move Re(c0)
        if keys[pygame.K_w]:
            c0_re += c_re_step * dt * 10.0
            needs_compute = True
        if keys[pygame.K_s]:
            c0_re -= c_re_step * dt * 10.0
            needs_compute = True

        # Q/E adjust Im(c0) velocity (Q decreases, E increases)
        if keys[pygame.K_q]:
            c_im_velocity -= c_im_step * dt * 10.0
        if keys[pygame.K_e]:
            c_im_velocity += c_im_step * dt * 10.0

        # Update c_im by its velocity (unless paused)
        if not paused:
            prev_c_im = c0_im
            c0_im += c_im_velocity * dt
            if abs(c0_im - prev_c_im) > 1e-6:
                needs_compute = True

        # compute fractal occasionally or when needed
        if needs_compute and (frame_count % COMPUTE_EVERY_FRAMES == 0):
            t0 = time.time()
            arr = compute_fractal(WIDTH, HEIGHT, center_kx, center_ky, scale,
                                  c0_re, c0_im, MAX_ITER, ESCAPE_RADIUS, USE_SMOOTH)
            surf = array_to_surface(arr, cmap)
            t1 = time.time()
            compute_time = t1 - t0
            needs_compute = False
        # if not computed yet, just fill black
        if 'surf' not in locals():
            screen.fill((0, 0, 0))
        else:
            screen.blit(surf, (0, 0))

        # HUD overlay
        info_lines = [
            f"center_k = ({center_kx:.5f} , {center_ky:.5f})",
            f"scale = {scale:.5f}",
            f"c0_re = {c0_re:.5f}    c0_im = {c0_im:.5f}",
            f"c_im_velocity = {c_im_velocity:.5f} (Q/E to change, R reverse, SPACE pause)",
            f"MAX_ITER = {MAX_ITER}  compute_time = {compute_time:.3f}s" if 'compute_time' in locals() else "",
            "Controls: arrows pan k-plane | W/S Re(c0) | Q/E change Im(c0) velocity",
            "A/D zoom out/in | R reverse Im(c0) motion | SPACE pause/resume"
        ]
        y = 8
        box_w = 420
        box_h = 16 * len(info_lines) + 8
        # translucent background
        s = pygame.Surface((box_w, box_h), pygame.SRCALPHA)
        s.fill((0, 0, 0, 140))
        screen.blit(s, (8, 8))
        for line in info_lines:
            if not line:
                continue
            text_surf = font.render(line, True, (255, 255, 255))
            screen.blit(text_surf, (12, y))
            y += 16

        pygame.display.flip()

    pygame.quit()

if __name__ == "__main__":
    main()
